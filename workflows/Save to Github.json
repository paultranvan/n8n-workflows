        "jsCode": "// Add a new field called 'myNewField' to the JSON of the item\n\nconsole.log('input : ', $input.item.json)\nconst workflowStr = $input.item.json.workflow\nconst workflow = JSON.parse(workflowStr)\nconst name = workflow.name\n\nconst tokens = name.split(' -- ')\nlet newName = `${tokens[0]} -- ${$('File is different').item.json.sha}`\nconsole.log('name : ', workflow.name)\nconsole.log('new name : ', newName)\nworkflow.name = newName\n$input.item.json.workflow = JSON.stringify(workflow)\n\nreturn $input.item;"
