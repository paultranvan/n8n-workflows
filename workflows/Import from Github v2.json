 {\n    console.log(\"SAME\");\n    $json.github_status = \"same\";\n  } else {\n    console.log(\"DIFFERENT\");\n    $json.github_status = \"different\";\n    $json.n8n_data_stringy = JSON.stringify(orderedActual, null, 2);\n  }\n  $json.content_decoded = orderedOriginal;\n  // No file returned / new workflow\n} else if (Object.keys($json).includes(\"github_content\")) {\n  const origWorkflow = JSON.parse($json.github_content);\n  const n8nWorkflow = JSON.parse($(\"n8n - workflows\").item.json.n8n_content);\n\n  // Order JSON objects\n  const orderedOriginal = orderJsonKeys(origWorkflow);\n  const orderedActual = orderJsonKeys(n8nWorkflow);\n\n  console.log(\"original  : \", orderedOriginal);\n  console.log(\"actual  : \", orderedActual);\n\n  // Determine difference\n  if (JSON.stringify(orderedOriginal) === JSON.stringify(orderedActual)) {\n    $json.github_status = \"same\";\n  } else {\n    $json.github_status = \"different\";\n    $json.n8n_data_stringy = JSON.stringify(orderedActual, null, 2);\n  }\n  $json.content_decoded = orderedOriginal;\n} else {\n  // Order JSON object\n  const n8nWorkflow = $(\"n8n - workflows\").item.json;\n  const orderedActual = orderJsonKeys(n8nWorkflow);\n\n  // Proper formatting\n  $json.github_status = \"new\";\n  $json.n8n_data_stringy = JSON.stringify(orderedActual, null, 2);\n}\n\n// Return items\nreturn $json;\n"},"id":"3396a0ab-1100-4937-9150-13536679e888","name":"isDiffOrNew","type":"n8n-nodes-base.code","position":[1360,4060],"typeVersion":1},{"parameters":{"mode":"combine","advanced":true,"mergeByFields":{"values":[{"field1":"name","field2":"name"}]},"options":{}},"type":"n8n-nodes-base.merge","typeVersion":3.1,"position":[1000,3620],"id":"756f652d-c124-45d8-9eaa-b51bd8d02192","name":"Merge"},{"parameters":{"assignments":{"assignments":[{"id":"67307039-d8ce-4a0b-8556-740055ce7a6d","name":"name","value":"={{ $json.name }}","type":"string"},{"id":"2f987fae-745f-4c81-9e24-cd67b6ccc987","name":"=n8n_content","value":"={{ $js